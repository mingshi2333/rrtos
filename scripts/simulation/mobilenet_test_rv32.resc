:name: mobilenet_test_virt_rv32
:description: RISC-V 32-bit virt machine

# Historical script: model-specific experiment, not a supported lane.
$bin?=@build/mobilenet_test

mach create "riscv32-virt"

machine LoadPlatformDescription @scripts/simulation/riscv32_virt.repl

showAnalyzer sysbus.uart0

sysbus LoadELF $bin
sysbus.cpu PC 0x20000000
start
