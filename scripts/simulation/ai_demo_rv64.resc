:name: ai_demo_virt_rv64
:description: RISC-V 64-bit virt machine for ai_demo

# Historical script: experimental and not part of the supported matrix.
$bin?=@build/apps/ai_demo/ai_demo

mach create "riscv64-virt"

machine LoadPlatformDescription @scripts/simulation/riscv64_virt.repl

showAnalyzer sysbus.uart0

sysbus LoadELF $bin
# Entry point is set automatically by LoadELF
start
