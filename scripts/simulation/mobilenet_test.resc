:name: mobilenet_test_virt_rv64
:description: RISC-V 64-bit virt machine

# Historical script: model-specific RV64 experiment, not a supported lane.
$bin?=@build/mobilenet_test

mach create "riscv64-virt"

machine LoadPlatformDescription @scripts/simulation/riscv64_virt.repl

showAnalyzer sysbus.uart0

sysbus LoadELF $bin
sysbus.cpu PC 0x80000000
start
